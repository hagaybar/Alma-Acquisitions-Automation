# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/

# Virtual environments
.venv/
venv/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Secrets and production configs
.env
*.env
config/*_prod*.json
config/*_sandbox*.json
config/test_config.json

# Data files (never commit)
input/*.xlsx
input/*.tsv
input/*.csv
processed/*.pdf
*.tsv
*.xlsx

# Output (logs and reports, never commit)
output/**
logs/**
*.log

# Keep directory structure
!input/.gitkeep
!output/.gitkeep
!logs/.gitkeep
!processed/.gitkeep
!failed/.gitkeep

# OS
.DS_Store
Thumbs.db

# Babysitter (only ignore node_modules, cache, and logs - keep runs/processes)
.a5c/node_modules/
.a5c/cache/
.a5c/logs/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Invoice closer batch runs on the production workstation: input exports and run output stay local.
# Must be ignored: auto-deploy skips a clone whose working tree is not clean.
tests/invoice_closer/input/*
!tests/invoice_closer/input/.gitkeep
tests/invoice_closer/output/*
!tests/invoice_closer/output/.gitkeep
# Operator copies of batch files with local settings (editing the tracked .bat would leave
# the clone dirty, and the scheduled auto-deploy skips a dirty clone).
batch/*.local.bat
